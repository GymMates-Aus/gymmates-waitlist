# ─────────────────────────────────────────────────────────────────────────────
# GymMates waitlist · environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored. On Vercel, paste the same values into the project's Environment
# Variables panel (Production + Preview).
# ─────────────────────────────────────────────────────────────────────────────

# Beehiiv API (https://developers.beehiiv.com)
#
# 1. Create a publication at https://app.beehiiv.com.
# 2. Generate an API key: Settings → Integrations → API.
# 3. Find the publication id: Settings → Integrations → API. It looks like
#    `pub_00000000-0000-0000-0000-000000000000`.
#
# When both vars are set, the API route hits Beehiiv. When either is missing,
# the route falls back to a stub response so local dev still works.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
